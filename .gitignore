# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class

# Generated exploit keys & signatures (keep xiaomi.pem)
bin/private.pem
bin/public.pem
bin/signature.bin
*.pem
!bin/xiaomi.pem

# Dumped partitions & patched images
*.img
bin/*.img
bin/lk_patched.img
bin/lk_a.img
bin/lk_b.img

# Extracted preloaders & download agents
*.bin
bin/preloader*.bin
bin/DA*.bin
bin/MTK*.bin

# Backup folders
backup/
*/backup/
bin/backup/
Restore/backup/

# Antumbra state & session files
.antumbra_state
bin/.antumbra_state
*.antumbra_state
*.state

# Release archives & compressed packages
# WDI generated runtime driver cache
usb_driver/
bin/usb_driver/

# OS & Editor files
*.7z

# Temporary logs & files
*.log
*.tmp
bin/*.log
bin/*.tmp

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*~
